# Copy this file to application.properties and fill in your values
server.port=8080
server.servlet.context-path=/api

spring.data.mongodb.uri=${MONGODB_URI:YOUR_MONGODB_URI_HERE}
spring.data.mongodb.database=${MONGODB_DATABASE:hospital_db}

app.jwt.secret=${JWT_SECRET:YOUR_JWT_SECRET_HERE}
app.jwt.expiration-ms=86400000
app.jwt.refresh-expiration-ms=604800000

app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}

spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.time-zone=UTC
logging.level.com.hospital=INFO